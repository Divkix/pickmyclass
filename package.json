{
  "name": "pickmyclass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "vp preview",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "fix": "vp check --fix",
    "knip": "knip",
    "verify": "pnpm run check && pnpm run type-check && pnpm run knip",
    "preview": "vp build && wrangler dev",
    "deploy": "POSTHOG_UPLOAD_SOURCEMAPS=true vp build && pnpm run db:migrate && wrangler deploy && wrangler triggers deploy && pnpm run seo:indexnow",
    "cf-typegen": "wrangler types --config wrangler.jsonc --env-file /dev/null --env-interface CloudflareEnv lib/cloudflare-env.d.ts",
    "test": "vp test run --project '!db'",
    "test:unit": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:db": "vp test run --project db",
    "test:coverage": "vp test run --project '!db' --coverage",
    "test:watch": "vp test --project '!db'",
    "test:ui": "vp test --ui --project '!db'",
    "type-check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "generate:og": "tsx scripts/generate-og-image.ts",
    "seo:lastmod": "tsx scripts/bump-lastmod.ts",
    "seo:indexnow": "tsx scripts/submit-indexnow.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@clerk/react": "^6.17.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.434.17",
    "posthog-node": "^5.54.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@posthog/rollup-plugin": "^1.6.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "satori": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vinext": "1.0.0-beta.13",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@12.6.0"
}
