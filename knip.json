{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["**/*.{ts,tsx,css}"],
  "ignore": ["app/routeTree.gen.ts", "tests/mocks/**", "tools/oxlint/anti-slop/**"],
  "ignoreDependencies": ["cloudflare", "@tanstack/intent"],
  "ignoreExportsUsedInFile": false,
  "includeEntryExports": false,
  "tanstack-router": {
    "entry": ["app/{start,router,client}.{ts,tsx}", "app/routes/**/*.{ts,tsx}"]
  }
}
