{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "next": {
    "entry": [
      "app/**/page.tsx",
      "app/**/layout.tsx",
      "app/**/route.ts",
      "app/**/loading.tsx",
      "app/**/error.tsx",
      "app/**/not-found.tsx",
      "app/sitemap.ts",
      "app/robots.ts",
      "middleware.ts"
    ]
  },
  "entry": ["worker.ts"],
  "project": ["**/*.{ts,tsx}"],
  "ignore": ["lib/supabase/database.types.ts", "components/ui/**", "tests/mocks/**"],
  "ignoreDependencies": [
    "supabase",
    "tailwindcss",
    "tw-animate-css",
    "postcss",
    "cloudflare",
    "@vitejs/plugin-rsc",
    "react-server-dom-webpack",
    "husky",
    "lint-staged"
  ],
  "ignoreBinaries": ["husky"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
