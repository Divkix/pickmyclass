{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "worker.ts",
    "global.d.ts",
    "next-env.d.ts",
    "lib/types/queue.ts",
    "lib/asu/asu-client.ts",
    "lib/types/notification.ts",
    "lib/types/stagger.ts",
    "lib/api/wire.ts",
    "lib/email/templates/footer.ts",
    "lib/queue/section-retirement.ts",
    "lib/queue/pending-notifications.ts",
    "lib/queue/notification-claims.ts",
    "lib/db/schema/pending-section-notifications.ts",
    "lib/workflows/cron-workflows.ts",
    "lib/telemetry/span.ts",
    "lib/worker/api-errors.ts",
    "lib/worker/edge-html-cache.ts",
    "lib/worker/markdown-negotiation.ts",
    "lib/cloudflare-env.d.ts",
    "lib/cloudflare-env.supplemental.d.ts"
  ],
  "exclude": ["node_modules"]
}
