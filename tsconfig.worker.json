{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "worker.ts",
    "global.d.ts",
    "lib/types/queue.ts",
    "lib/types/notification.ts",
    "lib/types/stagger.ts",
    "lib/api/wire.ts",
    "lib/worker/cron-lock.ts",
    "lib/worker/edge-html-cache.ts",
    "lib/cloudflare-env.d.ts",
    "lib/cloudflare-env.supplemental.d.ts"
  ],
  "exclude": ["node_modules"]
}
