{
  "main": "./worker.ts",
  "name": "pickmyclass",
  "compatibility_date": "2026-05-07",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // TanStack Start renders every page, so a stray public/*.html must never
    // answer an extensionless route ahead of the request gate (auth + CSP).
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "placement": {
    "mode": "smart",
  },
  // Keep crons empty: schedules live on the Workflow bindings below. This clears the old
  // Worker scheduled() triggers; 'pnpm run deploy' runs 'wrangler triggers deploy'.
  "triggers": {
    "crons": [],
  },
  // Each class_name must match a class re-exported from worker.ts or deployment fails.
  "workflows": [
    {
      "name": "pickmyclass-section-check",
      "binding": "SECTION_CHECK_WORKFLOW",
      "class_name": "SectionCheckWorkflow",
      "schedules": ["0,15,30,45 * * * *"],
    },
    {
      "name": "pickmyclass-maintenance",
      "binding": "MAINTENANCE_WORKFLOW",
      "class_name": "MaintenanceWorkflow",
      "schedules": ["5 * * * *"],
    },
  ],
  // Workers Free allows roughly 10k queue operations/day; delivery costs about 3 per message.
  "queues": {
    "producers": [
      {
        "binding": "PICKMYCLASS_QUEUE",
        "queue": "pickmyclass-queue",
      },
    ],
    "consumers": [
      {
        "queue": "pickmyclass-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_concurrency": 20,
        "max_retries": 3,
        "retry_delay": 60,
        // No consumer on the DLQ: exhausted messages stay there to inspect or
        // redrive from the dashboard (24h retention on Workers Free).
        "dead_letter_queue": "pickmyclass-dlq",
      },
    ],
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "migrations": [
    {
      "tag": "v2",
      "new_classes": ["CronLockDO"],
    },
    {
      // CronLockDO replaced by Workflow schedules; deleting the class drops its storage.
      // Never reuse the deleted CronLockDO class name.
      "tag": "v3",
      "deleted_classes": ["CronLockDO"],
    },
  ],
  "logpush": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "persist": false,
      "invocation_logs": true,
      // Sent only to HyperDX: "persist": false keeps no Cloudflare copy, so it is not billed.
      "destinations": ["hyperdx-logs"],
    },
    "traces": {
      "enabled": true,
      "persist": false,
      "destinations": ["hyperdx-traces"],
    },
  },
  "vars": {
    // Public: `clerkMiddleware` sends it to the browser in each page's Clerk init state.
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsucGlja215Y2xhc3MuYXBwJA",
    "MAX_WATCHES_PER_USER": "10",
    "NOTIFICATION_FROM_EMAIL": "notifications@pickmyclass.app",
    "NEXT_PUBLIC_SITE_URL": "https://pickmyclass.app",
    "OTEL_COLLECTOR_URL": "https://otel.divkix.me",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "749d7808617942ceabbca1059710fbbf",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres",
    },
  ],
}
