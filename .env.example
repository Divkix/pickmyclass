# Monitoring
# Unlocks the detailed /api/monitoring/health response
# Used with Bearer authentication: Authorization: Bearer <CRON_SECRET>
# Example generation: openssl rand -hex 32
CRON_SECRET=your_random_32_character_secret_here

# ASU Class Search API Configuration
# Set via Cloudflare secrets (wrangler secret put ASU_API_BASE_URL / ASU_API_TOKEN)
# ASU_API_BASE_URL=
# ASU_API_TOKEN=

# Hyperdrive — PlanetScale Postgres (via Cloudflare Hyperdrive)
# Production uses the wrangler.jsonc hyperdrive binding + wrangler secrets.
# For local `pnpm run dev` (vinext + @cloudflare/vite-plugin), wrangler.jsonc already has localConnectionString = postgresql://postgres:postgres@localhost:5432/postgres so it works out-of-box if local Postgres is running.
# To override (e.g. different port/db), set:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@localhost:5432/postgres
# Migration tooling (db:migrate / db:studio) and test:db need the DIRECT PlanetScale
# connection string, never Hyperdrive (see drizzle.config.ts):
# DATABASE_URL=postgres://...

# Email Configuration (Cloudflare Email Service)
# Sender address must be enabled for Cloudflare Email Sending.
NOTIFICATION_FROM_EMAIL=notifications@pickmyclass.app

# Site URL (for unsubscribe links)
# Base URL of your deployed site
# For development: http://localhost:3000
# For production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Security Configuration
# Maximum number of class watches a single user can create
# Prevents abuse and database bloat
# Default: 10 (reasonable limit for most students)
MAX_WATCHES_PER_USER=10

# Unsubscribe Token Signing Secret
# Generate with: openssl rand -hex 32
# REQUIRED: Set via wrangler secret put UNSUBSCRIBE_SIGNING_SECRET
UNSUBSCRIBE_SIGNING_SECRET=your_unsubscribe_signing_secret_here

# Browser telemetry ingest key (HyperDX / ClickStack collector)
# The /otel proxy attaches it when forwarding browser OTLP to OTEL_COLLECTOR_URL
# (a wrangler var). Unset: /otel accepts and drops every batch.
# Set via: wrangler secret put OTEL_BROWSER_INGEST_KEY
# OTEL_BROWSER_INGEST_KEY=
