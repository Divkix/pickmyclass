# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Server-side only)
# Used for operations that bypass Row Level Security (RLS)
# REQUIRED for cron jobs and admin operations
# WARNING: Keep this secret! Never expose to client-side code
# Find this in: https://app.supabase.com/project/_/settings/api (under "service_role key")
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cron Job Authentication
# Secret token for authenticating manual cron triggers
# Generate a secure random 32-character string
# Used with Bearer authentication: Authorization: Bearer <CRON_SECRET>
# Example generation: openssl rand -base64 32
CRON_SECRET=your_random_32_character_secret_here

# ASU Class Search API Configuration
# Set via Cloudflare secrets (wrangler secret put ASU_API_BASE_URL / ASU_API_TOKEN)
# ASU_API_BASE_URL=
# ASU_API_TOKEN=

# Hyperdrive — PlanetScale Postgres (via Cloudflare Hyperdrive)
# Production uses wrangler.jsonc hyperdrive binding id 4dd6f09... + wrangler secrets.
# For local `pnpm run dev` (vinext + @cloudflare/vite-plugin), wrangler.jsonc already has localConnectionString = postgresql://postgres:postgres@localhost:5432/postgres so it works out-of-box if local Postgres is running.
# To override (e.g. different port/db), set:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@localhost:5432/postgres
# Also accepted by lib/db/client.ts fallback: DATABASE_URL=...

# Email Configuration (Cloudflare Email Service)
# Sender address must be enabled for Cloudflare Email Sending.
NOTIFICATION_FROM_EMAIL=notifications@pickmyclass.app

# Supabase Auth Send Email Hook
# Generate in Supabase Dashboard > Authentication > Hooks > Send Email.
# Set the same value in Cloudflare with:
# wrangler secret put SUPABASE_SEND_EMAIL_HOOK_SECRET
SUPABASE_SEND_EMAIL_HOOK_SECRET=v1,whsec_your_supabase_hook_secret_here

# Site URL (for unsubscribe links)
# Base URL of your deployed site
# For development: http://localhost:3000
# For production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog analytics
# The public project token and ingestion host are committed literals in
# lib/analytics/config.ts so production builds always inline a real token
# (wrangler vars alone are runtime-only and are not enough).
#
# Source-map upload is BUILD-ONLY and opt-in: the deploy script sets
# POSTHOG_UPLOAD_SOURCEMAPS=true, which requires these two personal-API-token
# values from .env.production.local (never commit them, never ship them to the
# client bundle, never place them in Worker secrets):
# POSTHOG_API_KEY=phx_...
# POSTHOG_PROJECT_ID=...

# Security Configuration
# Maximum number of class watches a single user can create
# Prevents abuse and database bloat
# Default: 10 (reasonable limit for most students)
MAX_WATCHES_PER_USER=10

# Unsubscribe Token Signing Secret
# Generate with: openssl rand -hex 32
# REQUIRED: Set via wrangler secret put UNSUBSCRIBE_SIGNING_SECRET
UNSUBSCRIBE_SIGNING_SECRET=your_unsubscribe_signing_secret_here
